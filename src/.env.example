# tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
whisper_model = "large-v3-turbo"
# auto, cpu, cuda
whisper_device = "auto"
# default, int8, float16, float32, ...
whisper_compute_type = "default"
whisper_cpu_threads = "23"
whisper_use_vad = "true"
subtitle_max_length = 80
parallel_workers = 1
parallel_downloads = 3
# Comma separated, ".example.org" also allows all subdomains. Empty: every
# host is allowed (not recommended)
allowed_download_hosts = ""
# login_username and login_password have no defaults and have to be set
